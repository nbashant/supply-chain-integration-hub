APP_ENVIRONMENT=local
APP_LOG_LEVEL=INFO
ALLOWED_HOSTS=127.0.0.1,localhost,testserver,api
PARTNER_API_TOKEN=replace-for-shared-environments
DATABASE_URL=postgresql+psycopg://supply_chain:supply_chain@db:5432/supply_chain_hub
REDIS_URL=redis://redis:6379/0
OBJECT_STORAGE_ENDPOINT=http://object-store:8333
OBJECT_STORAGE_ACCESS_KEY=supply-chain-local
OBJECT_STORAGE_SECRET_KEY=replace-for-shared-environments
OBJECT_STORAGE_BUCKET=supply-chain-data
OBJECT_STORAGE_REGION=us-east-1
IMPORT_MAX_ATTEMPTS=3
IMPORT_RETRY_BASE_SECONDS=2
IMPORT_RETRY_MAX_SECONDS=60
IMPORT_LEASE_SECONDS=300
IMPORT_REDISPATCH_SECONDS=60
POSTGRES_DB=supply_chain_hub
POSTGRES_USER=supply_chain
POSTGRES_PASSWORD=local-development-only
GRAFANA_ADMIN_PASSWORD=replace-for-shared-environments
